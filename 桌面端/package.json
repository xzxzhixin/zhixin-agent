{
  "name": "@zhixin/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "scripts/electron-main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "test": "node tests/lifecycle-check.mjs",
    "start": "pnpm run preview",
    "preview": "electron ."
  },
  "build": {
    "appId": "cn.zhixin.agent",
    "productName": "致心智能体",
    "files": [
      "dist/**",
      "图标.png"
    ],
    "extraResources": [
      {
        "from": "../中心服务/dist",
        "to": "中心服务/dist"
      },
      {
        "from": "../图标.png",
        "to": "图标.png"
      }
    ],
    "win": {
      "icon": "图标.png"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@zhixin/shared": "workspace:*",
    "@vueuse/core": "12.4.0",
    "element-plus": "2.9.3",
    "github-markdown-css": "5.8.1",
    "marked": "15.0.6",
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "electron": "33.2.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  }
}
