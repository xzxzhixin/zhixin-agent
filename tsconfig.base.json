{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@zhixin/shared": [
        "共享/src/index.ts"
      ],
      "@zhixin/shared/*": [
        "共享/src/*"
      ]
    }
  },
  "exclude": [
    "中心",
    "**/中心/**",
    "node_modules",
    "dist",
    "build",
    "out"
  ]
}
