{
  "name": "zhixin-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "致心智能体多端工作区",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:frontend": "pnpm --filter @zhixin/frontend dev",
    "dev:desktop-shell": "node scripts/dev-desktop-shell.mjs",
    "dev:center:new": "pnpm --filter @zhixin/center dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:center:new": "pnpm --filter @zhixin/center build",
    "build:frontend": "pnpm --filter @zhixin/frontend build",
    "build:desktop-shell": "pnpm build:packages && pnpm build:center:new && pnpm build:frontend && pnpm --filter @zhixin/desktop-shell build",
    "build:builtin-plugins": "pnpm --filter \"./plugins/builtin-*\" build",
    "build:shared": "pnpm build:packages",
    "build:center": "pnpm build:center:new",
    "build:desktop": "pnpm build:desktop-shell",
    "build:web": "pnpm build:frontend",
    "check:web-dist-boundary": "node scripts/check-web-dist-boundary.mjs",
    "check:desktop-dev-startup": "node scripts/check-desktop-dev-startup.mjs"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.15.4"
  }
}
